<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="0dp"
        android:layout_height="?attr/actionBarSize"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:navigationContentDescription="@string/back"
        app:menu="@menu/menu_search"
        app:collapseIcon="@drawable/ic_close"
        app:collapseContentDescription="@string/close_search"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEditEvent"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/button_edit_event"
            android:textColor="@color/accent"
            app:strokeColor="@color/accent"
            app:cornerRadius="@dimen/button_corner"
            android:layout_marginEnd="@dimen/page_padding"
            android:layout_gravity="end"/>
    </com.google.android.material.appbar.MaterialToolbar>

    <TextView
        android:id="@+id/txtEventName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textAppearance="?attr/textAppearanceHeadlineSmall"
        android:textStyle="bold"
        android:layout_marginHorizontal="@dimen/page_padding"
        android:layout_marginTop="@dimen/space_small"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>
    <TextView
        android:id="@+id/txtEventInfo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_extra_small"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:textColor="@color/text_secondary"
        app:layout_constraintStart_toStartOf="@id/txtEventName"
        app:layout_constraintTop_toBottomOf="@id/txtEventName"
        app:layout_constraintEnd_toEndOf="@id/txtEventName"/>
    <TextView
        android:id="@+id/txtEventPlace"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:textColor="@color/text_secondary"
        android:layout_marginTop="@dimen/space_extra_small"
        app:layout_constraintTop_toBottomOf="@id/txtEventInfo"
        app:layout_constraintStart_toStartOf="@id/txtEventInfo"
        app:layout_constraintEnd_toEndOf="@id/txtEventInfo"/>
    <TextView
        android:id="@+id/txtEventContact"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:textColor="@color/text_secondary"
        android:layout_marginTop="@dimen/space_extra_small"
        app:layout_constraintTop_toBottomOf="@id/txtEventPlace"
        app:layout_constraintStart_toStartOf="@id/txtEventPlace"
        app:layout_constraintEnd_toEndOf="@id/txtEventPlace"/>
    <TextView
        android:id="@+id/txtEventDesc"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:textColor="@color/text_secondary"
        android:layout_marginTop="@dimen/space_extra_small"
        app:layout_constraintTop_toBottomOf="@id/txtEventContact"
        app:layout_constraintStart_toStartOf="@id/txtEventName"
        app:layout_constraintEnd_toEndOf="@id/txtEventName"/>
    <TextView
        android:id="@+id/txtSessionCount"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:textColor="@color/text_secondary"
        android:layout_marginTop="@dimen/space_extra_small"
        app:layout_constraintTop_toBottomOf="@id/txtEventDesc"
        app:layout_constraintStart_toStartOf="@id/txtEventName"
        app:layout_constraintEnd_toEndOf="@id/txtEventName"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerSessions"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/space_large"
        android:clipToPadding="false"
        android:paddingHorizontal="@dimen/page_padding"
        android:paddingBottom="@dimen/fab_clearance"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/txtSessionCount" />

    <TextView
        android:id="@+id/txtEmpty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:visibility="gone"
        android:textColor="@color/text_secondary"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/fabAddSession"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_margin="@dimen/space_medium"
        android:text="@string/add_session"
        app:icon="@drawable/ic_add"
        app:backgroundTint="@color/accent"
        android:textColor="@color/on_accent"
        app:iconTint="@color/on_accent" />
</androidx.constraintlayout.widget.ConstraintLayout>